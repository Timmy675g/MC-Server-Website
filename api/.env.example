# API service env
PORT=3001

# Allow your frontend origin(s), comma-separated, or *
CORS_ORIGINS=https://www.survivalkendy.systems,https://survivalkendy.systems

# Minecraft server target
MC_SERVER_HOSTS=play.example.net
MC_SERVER_PORT=25565
BEDROCK_PORT=19132

# Uptime Kuma public status settings
UPTIME_KUMA_STATUS_PAGE_URL=https://status.example.com/status/survivalkendy
UPTIME_KUMA_MONITOR_MINECRAFT=
UPTIME_KUMA_MONITOR_VM=

# Application system (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=survivalkendy_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=survivalkendy_db
APPLICATIONS_TABLE=applications
AUTO_WAITLIST_INTERVAL_MS=60000

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_SECRET=change_this_admin_secret
